# ============================================================================
# Jarvis Agent — variables de entorno
# Copia este fichero a `.env` y rellena los valores. NO versiones `.env`.
#   cp .env.example .env
# Genera los tokens con:  openssl rand -hex 32
# ============================================================================

# --- Autenticación de la API del agente (scripts y automatizaciones) ---
JARVIS_API_TOKEN=

# --- Contraseña para entrar desde el navegador (PWA) ---
# Genera el hash con:
#   docker compose exec jarvis-agent python -m app.security
# Si lo dejas vacío, el login del navegador acepta JARVIS_API_TOKEN.
JARVIS_ADMIN_PASSWORD_HASH=
# Duración de la sesión (días) y cookie Secure (true salvo pruebas en http).
JARVIS_SESSION_TTL_DAYS=30
JARVIS_COOKIE_SECURE=true

# --- Autenticación interna entre agente y servicio de herramientas ---
# Debe ser distinto del anterior.
JARVIS_TOOLS_TOKEN=

# --- LLM en la nube (API compatible con OpenAI) ---
# OpenRouter: https://openrouter.ai/api/v1
# OpenAI:     https://api.openai.com/v1
# Groq:       https://api.groq.com/openai/v1
# Google AI (compatible OpenAI):
#   JARVIS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
JARVIS_LLM_BASE_URL=https://openrouter.ai/api/v1
JARVIS_LLM_API_KEY=
# Gratis (tool calling verificado): nvidia/nemotron-3-super-120b-a12b:free
#                                 minimax/minimax-m3.1-flash:free
#                                 google/gemma-4-26b-a4b-it:free
# De pago (mejor calidad/estabilidad): google/gemini-2.0-flash-001 · openai/gpt-4o-mini
# Google AI directo: gemini-2.0-flash
JARVIS_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Cadena de reserva si el principal falla (429/5xx/timeout).
JARVIS_LLM_FALLBACK_MODELS=minimax/minimax-m3.1-flash:free,google/gemma-4-26b-a4b-it:free,openrouter/free

# --- Política de fallback (opcional) ---
# JARVIS_LLM_MAX_RETRIES_SERVER=1
# JARVIS_LLM_RETRY_BACKOFF=0.8
# JARVIS_LLM_CIRCUIT_THRESHOLD=2
# JARVIS_LLM_CIRCUIT_COOLDOWN=60
# JARVIS_LLM_TOTAL_BUDGET=110

# --- Ajustes opcionales ---
# JARVIS_HISTORY_LIMIT=20
# JARVIS_MAX_TOOL_ITERATIONS=4
# JARVIS_LOG_TAIL_MAX=500
